---
import { PUBLIC_TURNSTILE_SITEKEY } from 'astro:env/client';
import { t, type Lang } from '../i18n/utils';
import SocialIcon from './SocialIcon.astro';
const { lang = 'es' as Lang } = Astro.props;
const turnstileSiteKey = (PUBLIC_TURNSTILE_SITEKEY ?? '').trim();
const turnstileEnabled = /^(0x|1x)[0-9A-Za-z_-]{10,}$/.test(turnstileSiteKey);
---
<section id="contacto" class="contact-section" aria-labelledby="contact-title">
  <div class="contact-grid">
    <div class="contact-intro">
      <p class="contact-eyebrow">{t(lang, 'contactEyebrow')}</p>
      <h2 id="contact-title">{t(lang, 'contactTitle')}</h2>
      <p class="contact-description">{t(lang, 'contactDescription')}</p>
      <ul class="contact-points">
        <li><svg aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" /><path d="m5 8 2 2 4-4" /></svg>{t(lang, 'noJargon')}</li>
        <li><svg aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" /><path d="m5 8 2 2 4-4" /></svg>{t(lang, 'businessFocus')}</li>
        <li><svg aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5" /><path d="m5 8 2 2 4-4" /></svg>{t(lang, 'personalReply')}</li>
      </ul>
      <a class="btn-primario" href="mailto:pabloagustingarrido@gmail.com">{t(lang, 'writeByEmail')} <span aria-hidden="true" class="btn-arrow">→</span></a>

      <div class="direct-channel">
        <p class="direct-eyebrow">{t(lang, 'directChannel')}</p>
        <a class="direct-email" href="mailto:pabloagustingarrido@gmail.com">pabloagustingarrido@gmail.com</a>
        <p class="direct-location">{t(lang, 'directLocation')}</p>
        <button class="copy-email" type="button" aria-live="polite" data-copied={t(lang, 'copied')} data-copy-label={t(lang, 'copyEmail')}>{t(lang, 'copyEmailInitial')}</button>
        <div class="direct-links">
          <a data-key="linkedin" class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors" href="https://www.linkedin.com/in/pablo-agustin-garrido/" target="_blank" rel="noopener noreferrer">
            <SocialIcon name="linkedin" size={20} />
            LinkedIn
          </a>
          <a data-key="github" class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors" href="https://github.com/ExcenGarrido" target="_blank" rel="noopener noreferrer">
            <SocialIcon name="github" size={20} />
            GitHub
          </a>
        </div>
      </div>
    </div>

    <form
      class="contact-form"
      data-contact-form
      data-label-sending={t(lang, 'contactFormSending')}
      data-label-success={t(lang, 'contactFormSuccess')}
      data-label-error={t(lang, 'contactFormError')}
      data-label-captcha={t(lang, 'contactFormCaptcha')}
      data-label-too-long={t(lang, 'contactFormTooLong')}
      data-label-server={t(lang, 'contactFormServer')}
    >
      <div class="contact-form-row">
        <div class="contact-form-field">
          <label for="contact-name">{t(lang, 'contactFormNameLabel')}</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            required
            minlength="2"
            maxlength="100"
            autocomplete="name"
            placeholder={t(lang, 'contactFormNamePlaceholder')}
          />
        </div>
        <div class="contact-form-field">
          <label for="contact-email">{t(lang, 'contactFormEmailLabel')}</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            maxlength="200"
            autocomplete="email"
            placeholder={t(lang, 'contactFormEmailPlaceholder')}
          />
        </div>
      </div>

      <div class="contact-form-field">
        <label for="contact-type">{t(lang, 'contactFormTypeLabel')}</label>
        <select id="contact-type" name="type" required>
          <option value="ai">{t(lang, 'contactFormTypeAi')}</option>
          <option value="docs">{t(lang, 'contactFormTypeDocs')}</option>
          <option value="api">{t(lang, 'contactFormTypeApi')}</option>
          <option value="job">{t(lang, 'contactFormTypeJob')}</option>
          <option value="other">{t(lang, 'contactFormTypeOther')}</option>
        </select>
      </div>

      <div class="contact-form-field">
        <label for="contact-message">{t(lang, 'contactFormMessageLabel')}</label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          required
          minlength="10"
          maxlength="1000"
          placeholder={t(lang, 'contactFormMessagePlaceholder')}
        ></textarea>
      </div>

      <input
        class="contact-form-honeypot"
        type="text"
        name="botcheck"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      {turnstileEnabled && (
        <div
          class="contact-form-turnstile"
          data-turnstile
          data-sitekey={turnstileSiteKey}
          data-language={lang}
        ></div>
      )}

      <button class="contact-form-submit" type="submit" data-submit-label={t(lang, 'contactFormSubmit')}>{t(lang, 'contactFormSubmit')}</button>
      <p class="contact-form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
<script>
  type TurnstileApi = {
    render: (element: HTMLElement, options: Record<string, unknown>) => string;
    reset: (widgetId?: string) => void;
  };

  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (contactForm) {
    const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = contactForm.querySelector<HTMLParagraphElement>('.contact-form-status');
    const submitLabel = submitButton?.dataset.submitLabel ?? submitButton?.textContent ?? '';
    const sendingLabel = contactForm.dataset.labelSending ?? submitLabel;
    const startedAt = performance.now();
    const defaultErrorLabel = contactForm.dataset.labelError ?? '';

    const errorLabel = (code?: string) => {
      if (code === 'captcha') return contactForm.dataset.labelCaptcha ?? defaultErrorLabel;
      if (code === 'payload_too_large') return contactForm.dataset.labelTooLong ?? defaultErrorLabel;
      if (code === 'server') return contactForm.dataset.labelServer ?? defaultErrorLabel;
      return defaultErrorLabel;
    };

    const turnstileContainer = contactForm.querySelector<HTMLElement>('[data-turnstile]');
    let turnstileApi: TurnstileApi | null = null;
    let turnstileWidgetId = '';
    let turnstileToken = '';

    const resetTurnstile = () => {
      turnstileToken = '';
      turnstileApi?.reset(turnstileWidgetId || undefined);
    };

    if (turnstileContainer) {
      const widgetScript = document.createElement('script');
      widgetScript.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      widgetScript.async = true;
      widgetScript.defer = true;
      widgetScript.addEventListener('load', () => {
        const api = (window as unknown as { turnstile?: TurnstileApi }).turnstile;
        if (!api) return;
        turnstileApi = api;
        turnstileWidgetId = api.render(turnstileContainer, {
          sitekey: turnstileContainer.dataset.sitekey ?? '',
          theme: 'dark',
          language: turnstileContainer.dataset.language ?? 'es',
          size: 'flexible',
          callback: (token: string) => { turnstileToken = token; },
          'expired-callback': () => { turnstileToken = ''; },
          'error-callback': () => { turnstileToken = ''; },
        });
      });
      document.head.append(widgetScript);
    }

    const setStatus = (message: string, state: 'success' | 'error' | '') => {
      if (!status) return;
      status.textContent = message;
      if (state) {
        status.dataset.state = state;
      } else {
        delete status.dataset.state;
      }
    };

    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!contactForm.reportValidity()) return;

      if (turnstileContainer && !turnstileToken) {
        setStatus(contactForm.dataset.labelCaptcha ?? defaultErrorLabel, 'error');
        return;
      }

      const data = new FormData(contactForm);
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = sendingLabel;
      }
      setStatus('', '');

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: String(data.get('name') ?? ''),
            email: String(data.get('email') ?? ''),
            type: String(data.get('type') ?? ''),
            message: String(data.get('message') ?? ''),
            botcheck: String(data.get('botcheck') ?? ''),
            elapsed: Math.round(performance.now() - startedAt),
            turnstileToken,
          }),
        });
        const payload = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;

        if (response.ok && payload?.ok) {
          setStatus(contactForm.dataset.labelSuccess ?? '', 'success');
          contactForm.reset();
          resetTurnstile();
        } else {
          setStatus(errorLabel(payload?.error), 'error');
          resetTurnstile();
        }
      } catch {
        setStatus(defaultErrorLabel, 'error');
        resetTurnstile();
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = submitLabel;
        }
      }
    });
  }

  const copyButton = document.querySelector('.copy-email');
  copyButton?.addEventListener('click', async () => {
    await navigator.clipboard.writeText('pabloagustingarrido@gmail.com');
    const button = copyButton as HTMLButtonElement;
    button.textContent = button.dataset.copied ?? '';
    window.setTimeout(() => { button.textContent = button.dataset.copyLabel ?? ''; }, 2000);
  });
</script>
